{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ccrp-query-engine:schema:catalogue:1.0.0",
  "title": "Catalogue",
  "description": "A host's field catalogue in catalogue format 1.0.0, generated by the engine's catalogue command (docs/decisions/0009-field-catalogue-file-format-and-commands.md).",
  "type": "object",
  "required": ["formatVersion", "generatedBy", "categories", "fields", "excludedColumns"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": { "enum": ["1.0.0"] },
    "generatedBy": { "description": "The engine version and command that wrote the file.", "type": "string" },
    "categories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Category" } },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/Field" } },
    "excludedColumns": { "type": "array", "items": { "$ref": "#/$defs/ExcludedColumn" } }
  },
  "$defs": {
    "Category": {
      "type": "object",
      "required": ["key", "title"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "Field": {
      "description": "A queryable building attribute: one column of the host's buildings table.",
      "type": "object",
      "required": ["key", "category", "title", "type", "multiValued", "allowedValues", "ambiguity"],
      "additionalProperties": false,
      "properties": {
        "key": { "description": "The buildings column.", "$ref": "#/$defs/ColumnName" },
        "category": { "description": "A category key.", "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "integer", "number", "boolean"] },
        "multiValued": { "description": "The column holds a list of values.", "type": "boolean" },
        "allowedValues": {
          "description": "The values the host's definitions allow, or null when any value of the type is allowed.",
          "oneOf": [
            { "type": "null" },
            { "type": "array", "minItems": 1, "items": { "type": ["string", "number"] } }
          ]
        },
        "ambiguity": {
          "description": "Why a stored value may not be an observation (a database default, say), or null.",
          "type": ["string", "null"]
        }
      }
    },
    "ExcludedColumn": {
      "description": "A buildings column the engine does not query, with the reason.",
      "type": "object",
      "required": ["column", "reason"],
      "additionalProperties": false,
      "properties": {
        "column": { "$ref": "#/$defs/ColumnName" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "ColumnName": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" }
  }
}
